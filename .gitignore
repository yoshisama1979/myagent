.env
data/financial/*
!data/financial/README.md
data/ycom/financial/*
!data/ycom/financial/README.md
*.Identifier

# 機密情報（APIキー・サービスアカウント等）
data/secrets/
*-key.json
service-account-*.json

# ランタイム生成物
data/cache/
__pycache__/

# 拠点横断メールボックスのメッセージ実体（クライアント情報を含み得る・git非追跡）
data/mailbox/

# Chatwork/メールの取得ログ・蒸留履歴（クライアント名・やり取り実体を含む・git非追跡）
data/comms/
site/comms/

# 月次アップロードデータ（売上・コスト等）
data/monthly/

# overseer / slack のランタイム状態・ログ・ロック・ハートビート（毎サイクル書き換わる・git非追跡）
data/overseer/
data/slack/
site/overseer/last-tick.txt
# 3Dオフィスが参照する hana-tools オフィス状況の30秒キャッシュ
# （クライアント名・作業内容が入る実行時データ＝クライアント情報はgit外の方針に従う）
data/office/

# AI-INDEX: 自動生成の在処マップ。git外のクライアント分析ページの見出しを含むため追跡しない
# （原本ページの .gitignore 方針が索引経由で漏れる抜け穴の封鎖。`python3 bin/build-ai-index.py` で再生成）
AI-INDEX.md

# SSL 有効期限チェックの実行ログ（毎朝 06:30 の cron が追記・ドメイン名と残日数だけだが
#  ランタイム生成物なので他のログと同じく git 非追跡。ドメイン一覧 domains.txt は追跡する）
data/ssl-check/*.log
# 警報の間引き状態（最後に通知できた日付。ランタイム状態）
data/ssl-check/notify-state

# Windows のファイル属性メタデータ（NTFS Zone.Identifier）
*Zone.Identifier

# 別プロジェクトの移植元ソース（_assistant/ への移植元として一時的に配置。myagent の git 履歴には含めない）
harness-factory-main/

# _assistant/ のローカル環境（venv・.env・Python キャッシュ）
_assistant/.venv/
_assistant/.env
_assistant/__pycache__/
_assistant/**/__pycache__/

# BigQuery 等の bin ツール用 venv（コミットしない）
bin/.venv/

# Node tooling (VPS-only: hp-shot 撮影ツール)
node_modules/
package-lock.json

# HP分析ループの生データ・スクリーンショット（VPS-local・コミットしない＝大容量/再生成可）
data/hp-loop/cycles/

# decks: 安全確認まで PDF/画像は追跡しない（deck-format.md 🚨節）
site/decks/ai-hisho/*.pdf
site/decks/ai-hisho/deck-images/
site/decks/ai-web-analysis/*.pdf
site/decks/ai-web-analysis/deck-images/
# decks: 質問事項レポートの PDF は /questions-deck で毎回再生成する生成物＝追跡しない
site/decks/analysis-questions/*.pdf
site/decks/analysis-questions/*/*.pdf

# ── クライアント分析は git 外＝VPS/Tailscale のみで保持（方針 2026-07-16 社長決定）──
